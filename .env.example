# AgriShield Environment Template (SIH 26131)
# Do NOT store real credentials or secrets in this file.

# ---------------------------------------------------------------------------
# Backend API Configuration
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.60
MAX_UPLOAD_SIZE_BYTES=15728640

# Production Allowed Origins (Comma-separated)
# Example: CORS_ORIGINS=https://agrishield.example.com,https://app.agrishield.example.com
CORS_ORIGINS=

# Model and Taxonomy Paths (Relative to ml-model root or absolute paths)
MODEL_PATH=models/best_model.pth
CLASS_INDICES_PATH=dataset/class_indices.json

# ---------------------------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------------------------
# In production, set to your live backend domain (e.g. https://api.agrishield.example.com)
VITE_API_BASE_URL=
