# AgriShield ML Backend Environment Template (SIH 26131)
# Do NOT store secrets or credentials in this file.

# Server Bind Settings (Default 0.0.0.0 for cloud container compatibility)
API_HOST=0.0.0.0
API_PORT=8000
# Cloud platforms (Render, Railway, Heroku, Cloud Run) inject PORT dynamically:
# PORT=8000

# Compute Device (cpu or cuda)
DEVICE=cpu

# Decision Thresholds
CONFIDENCE_THRESHOLD=0.60
TOP_K=3

# Maximum File Upload Size (15 MB in bytes)
MAX_UPLOAD_SIZE_BYTES=15728640

# Allowed CORS Origins (Comma-separated list of allowed frontend domains)
# Example: CORS_ORIGINS=https://agrishield.vercel.app,https://myfarm.com
CORS_ORIGINS=

# Model Artifact & Metadata Paths (Defaults resolve relative to ml-model/)
MODEL_PATH=models/best_model.pth
CLASS_INDICES_PATH=dataset/class_indices.json
